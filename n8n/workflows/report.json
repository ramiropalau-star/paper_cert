        "options": {
          "responseCode": 401
        }
      },
      "id": "b2c3d4e5-0006-4000-8000-000000000006",
      "name": "Respond unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
