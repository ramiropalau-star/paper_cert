          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Run report job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"report_job_id\": $('Webhook: report job').item.json.body.report_job_id, \"status\": $json.status } }}",
        "options": {}
      },
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
