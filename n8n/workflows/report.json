            {
              "id": "webhook-token-match",
              "leftValue": "={{ $json.headers['x-webhook-token'] }}",
              "rightValue": "={{ $env.APP_N8N_WEBHOOK_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0005-4000-8000-000000000005",
