# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public scheme the app is reached on. With APP_SCHEME=https, secure cookies,
# SSL redirect and HSTS turn on automatically; the DJANGO_SECURE_* vars below
# are explicit overrides (empty = follow APP_SCHEME).
APP_SCHEME=http
DJANGO_SECURE_COOKIES=
DJANGO_SECURE_SSL_REDIRECT=
# HSTS overrides (empty = follow APP_SCHEME; https enables 1y + subdomains)
DJANGO_SECURE_HSTS_SECONDS=
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Bind address for published ports. The app is the user entry point (keep 0.0.0.0
# or restrict to a specific interface/reverse proxy). n8n is an admin UI and
# defaults to loopback; set N8N_BIND_ADDR=0.0.0.0 only for direct LAN access.
APP_BIND_ADDR=0.0.0.0
N8N_BIND_ADDR=127.0.0.1
APP_PORT=8080

# Initial admin (used once by `manage.py bootstrap`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Database (application + Paperless + n8n share this PostgreSQL instance)
DB_ENGINE=postgres
DB_NAME=paperless_certs
DB_USER=paperless
DB_PASSWORD=change-me-db-password
DB_HOST=db
DB_PORT=5432

# Paperless-ngx and n8n share the same PostgreSQL instance and
# authenticate with DB_USER/DB_PASSWORD above.

# Application paths (container paths; mounted volumes in compose)
APP_MEDIA_ROOT=/data/media
APP_REPORT_OUTPUT_DIR=/data/reports

# Uploads and text acquisition
# Per-file limit enforced during intake validation.
APP_UPLOAD_MAX_BYTES=26214400
# Total HTTP request body limit enforced by middleware before parsing.
# Must be >= APP_UPLOAD_MAX_BYTES; multi-file uploads are bounded by this total.
APP_REQUEST_MAX_BYTES=104857600
APP_PDF_MAX_PAGES=100
APP_EMBEDDED_TEXT_MIN_CHARS=30
APP_OCR_MIN_TEXT_CHARS=30
APP_OCR_LOW_CONFIDENCE_THRESHOLD=0.55

# OCR service
APP_OCR_URL=http://ocr:8000
APP_OCR_LANGUAGES=eng,spa
APP_OCR_TIMEOUT_SECONDS=660
APP_OCR_RETRIES=2

# Ollama
APP_OLLAMA_URL=http://ollama:11434
APP_OLLAMA_MODEL=qwen2.5:7b-instruct
APP_OLLAMA_TIMEOUT_SECONDS=180
APP_OLLAMA_RETRIES=2
APP_LLM_MAX_INPUT_CHARS=40000
APP_CONFIDENCE_REVIEW_THRESHOLD=0.6
# Format profiles learned from approved certificates (entity + issuance year)
APP_FORMAT_MIN_SAMPLES=2
APP_FORMAT_MIN_EXAM_SAMPLES=3
APP_FORMAT_SCORE_THRESHOLD=0.4
APP_FORMAT_MAX_SCORE=0.5

# Paperless-ngx
APP_PAPERLESS_URL=http://paperless:8000
# Browser-facing base URL used for "view original" links. Point this at
# however operators reach Paperless (e.g. an SSH tunnel or a published port).
# Leave empty to hide the link; the in-app original viewer still works.
APP_PAPERLESS_UI_URL=http://localhost:9090
APP_PAPERLESS_TOKEN=change-me-paperless-api-token
# Paperless-ngx tag applied to unrecognized documents awaiting manual review.
APP_PAPERLESS_OTHER_TAG=Otros
APP_PAPERLESS_TIMEOUT_SECONDS=30
APP_PAPERLESS_POLL_INTERVAL_SECONDS=1
APP_PAPERLESS_POLL_TIMEOUT_SECONDS=60
# Retries (with exponential backoff) for idempotent Paperless GET/PATCH/DELETE calls.
APP_PAPERLESS_RETRIES=2
APP_PAPERLESS_RETRY_BACKOFF_SECONDS=0.5

# Paperless-ngx container settings
PAPERLESS_SECRET_KEY=change-me-paperless-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-paperless-admin-password
PAPERLESS_URL=http://localhost:9090
PAPERLESS_OCR_LANGUAGE=spa+eng

# Internal API and n8n webhooks
APP_INTERNAL_API_TOKEN=change-me-internal-token
APP_N8N_PROCESSING_WEBHOOK_URL=http://n8n:5678/webhook/process-document
APP_N8N_REPORT_WEBHOOK_URL=http://n8n:5678/webhook/report-job
APP_N8N_WEBHOOK_TOKEN=change-me-n8n-token
APP_N8N_WEBHOOK_TIMEOUT_SECONDS=10

# Watched inbox folder (bind-mounted to ./inbox in compose)
APP_INBOX_DIR=/data/inbox
APP_INBOX_POLL_SECONDS=10
# Seconds a file must keep a stable size+mtime before the watcher reads it
APP_INBOX_SETTLE_SECONDS=2
APP_PAPERLESS_SYNC_SECONDS=60
APP_PAPERLESS_WEBHOOK_TARGET=

# Sync watermark overlap and thumbnail cache
APP_SYNC_OVERLAP_SECONDS=600
APP_CACHE_DIR=var/cache

# Stuck-work recovery (watcher loop and `manage.py recover_stuck`)
APP_RECOVERY_INTERVAL_SECONDS=60
APP_RECOVERY_STALE_SECONDS=1800
APP_RECOVERY_MAX_ATTEMPTS=3

# n8n container settings
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
GENERIC_TIMEZONE=UTC
# Esquema público bajo el que los operadores acceden a la UI de n8n.
# deploy.sh deriva N8N_SECURE_COOKIE: https -> true, http -> false (con
# advertencia). Para HTTPS usá un reverse proxy y poné N8N_PROTOCOL=https.
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Logging
LOG_LEVEL=INFO
# keyvalue (default) or json
LOG_FORMAT=keyvalue
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:9090,http://127.0.0.1:9090

# Email (password reset). Default backend prints emails to the app logs
# (console). Set APP_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# plus the SMTP vars below to deliver real emails.
APP_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
APP_EMAIL_HOST=
APP_EMAIL_PORT=587
APP_EMAIL_HOST_USER=
APP_EMAIL_HOST_PASSWORD=
APP_EMAIL_USE_TLS=true
APP_DEFAULT_FROM_EMAIL=webmaster@localhost
